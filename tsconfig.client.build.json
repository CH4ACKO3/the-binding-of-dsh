{
  "extends": "./tsconfig.client.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": [
    "src/client/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "src/shared/peer-remote.ts"
  ]
}
