{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "src/client/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "src/shared/peer-remote.ts"
  ]
}
